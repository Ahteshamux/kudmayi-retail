# Copy this file to .env.local and fill in the values below.
# Never commit .env.local, and never paste any of these values into chat.

# Supabase → Project Settings → API. Both are safe in a browser — never
# put the service_role key here. Used by /admin/catalog (the internal
# tool) and by image uploads for /admin/products.
NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → Database → Connection string — use the
# "Transaction" pooler mode (port 6543) for serverless/Next.js. Powers
# /admin/products and the public storefront catalog via Drizzle ORM. Run
# supabase/storefront-setup.sql first. Without this, the storefront runs
# fine on its built-in placeholder catalog, but /admin/products can't save
# anything.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
